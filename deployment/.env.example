# Predator Hunters Platform - Environment Configuration
# Copy this to .env and customize for your environment

# ===========================================================================
# DATABASE
# ===========================================================================
SURREAL_PASS=your-secure-password-here
DATABASE_URL=ws://surrealdb:8000

# ===========================================================================
# SECURITY
# ===========================================================================
JWT_SECRET=generate-a-strong-random-secret-here
SESSION_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# ===========================================================================
# OBJECT STORAGE (MinIO/S3)
# ===========================================================================
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-this-password
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=change-this-password
S3_BUCKET_EVIDENCE=evidence
S3_BUCKET_MEDIA=media
S3_BUCKET_THUMBNAILS=thumbnails
S3_BUCKET_PREVIEWS=previews

# ===========================================================================
# MEDIA PROCESSING
# ===========================================================================
MAX_UPLOAD_SIZE=524288000  # 500MB
MAX_VIDEO_DURATION=3600    # 1 hour
TRANSCODE_QUALITY=medium   # low, medium, high
THUMBNAIL_INTERVAL=5       # seconds between thumbnail captures

# ===========================================================================
# AI / FACE RECOGNITION
# ===========================================================================
MODEL_PATH=/models/facenet.onnx
FACE_SEARCH_RATE_LIMIT=10  # queries per hour per user
MIN_CONFIDENCE_THRESHOLD=0.75
MAX_CANDIDATES=20

# ===========================================================================
# RATE LIMITING
# ===========================================================================
REDIS_URL=redis://redis:6379
RATE_LIMIT_PUBLIC=100      # requests per minute per IP
RATE_LIMIT_AUTH=1000       # requests per minute per user
RATE_LIMIT_BUSINESS_BASIC=100    # per hour
RATE_LIMIT_BUSINESS_PREMIUM=1000 # per hour

# ===========================================================================
# ALERTS
# ===========================================================================
ALERT_MAX_ACTIVE_PER_REGION=10
ALERT_DEFAULT_TTL_HOURS=168  # 1 week
ALERT_AUTO_ARCHIVE_DAYS=90

# ===========================================================================
# MAPPING
# ===========================================================================
TILE_SERVER_URL=http://tileserver:8080
NOMINATIM_URL=http://nominatim:8080
DEFAULT_MAP_CENTER_LAT=54.5
DEFAULT_MAP_CENTER_LON=-2.0
DEFAULT_MAP_ZOOM=6

# ===========================================================================
# LOGGING & MONITORING
# ===========================================================================
RUST_LOG=info
LOG_FORMAT=json  # json or text
ENABLE_REQUEST_LOGGING=true

# ===========================================================================
# RETENTION POLICIES (days)
# ===========================================================================
RETENTION_SESSION=30
RETENTION_AUDIT_SECURITY=2555  # 7 years
RETENTION_AUDIT_ACCESS=730     # 2 years
RETENTION_FACE_SEARCH_AUDIT=365
RETENTION_API_AUDIT=730

# ===========================================================================
# EXTERNAL SERVICES (Optional)
# ===========================================================================
VIRUS_SCAN_ENDPOINT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=noreply@predatorhunters.example

# ===========================================================================
# DEVELOPMENT
# ===========================================================================
ENABLE_CORS=true
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
ENABLE_DEBUG_ENDPOINTS=false
